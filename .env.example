# Copy to .env (same folder) and adjust. Real environment variables take priority.

# --- Local AI (optional: scanning works without it) ---
AI_ENABLED=true
# "ollama" or "openai" (OpenAI-compatible local server such as LM Studio)
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2
AI_TIMEOUT_SECONDS=60
# Source code is only sent to a non-local AI_BASE_URL if you explicitly set this to true.
AI_ALLOW_REMOTE=false

# --- Limits ---
MAX_CODE_CHARS=50000
MAX_PROMPT_CHARS=4000
RATE_LIMIT_PER_MINUTE=120

# --- CORS (comma separated) ---
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
